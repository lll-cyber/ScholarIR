# Copy to ScholarIR/.env (or configs/.env) — NOT env.example; that file is a template only.
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MAX_TOKENS=768
# DEEPSEEK_TEMPERATURE=0.2
# DEEPSEEK_THINKING=0
# SCHOLAR_IR_LLM_BACKEND=deepseek   # deepseek | local | openai | auto
GOOGLE_SERPER_KEY=
S2_API_KEY=
# Semantic Scholar rate limit (requests per second); authenticated tier often 1
S2_RATE_LIMIT_RPS=1
OPENALEX_MAILTO=
# Local LLM (Understanding) — pick ONE mode:
# A) In-process HF (default if model dir exists):
#    SCHOLAR_IR_LOCAL_MODEL_PATH=/data3/ai_inn/ScholarIR/LLMS/qwen2.5-gptq
#    pip install torch transformers accelerate auto-gptq
# B) vLLM OpenAI-compatible server (recommended for 32B):
#    SCHOLAR_IR_LLM_URL=http://127.0.0.1:8000/v1
#    SCHOLAR_IR_LLM_MODEL=Qwen2.5-32B-Instruct-GPTQ-Int4
#    SCHOLAR_IR_USE_LOCAL_HF=0
# SCHOLAR_IR_LLM_MAX_TOKENS=768
# SCHOLAR_IR_LLM_TEMPERATURE=0.2
